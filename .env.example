# Astro/build configuration only. Telegram Function secrets belong in .dev.vars.
# Ordinary local builds need no URL. Set this only after confirming the public origin.
# PUBLIC_SITE_URL=https://<confirmed-project-name>.pages.dev
HAYWEB_BUILD_TARGET=local
# Optional: exact content value supplied by Google Search Console (not the whole tag).
GOOGLE_SITE_VERIFICATION=
