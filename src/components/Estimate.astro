---
import type {Locale} from '../config';import {offerCopy} from '../offer-copy';import {translations} from '../i18n';import {requestPath} from '../lib/pricing';import ProjectOptions from './ProjectOptions.astro';import EstimateSummary from './EstimateSummary.astro';
interface Props{lang:Locale}const {lang}=Astro.props;const o=offerCopy[lang];
---
<section class="estimate panel" data-estimate data-lang={lang} data-copy={JSON.stringify({labels:o.labels,month:o.month,currency:translations[lang].currency})}><h2>{o.estimate}</h2><p>{o.note}</p><form><fieldset disabled data-enhance><ProjectOptions lang={lang}/></fieldset><EstimateSummary lang={lang}/><a class="button primary" data-estimate-link data-offer-cta href={requestPath(lang)}>{o.claim} ↗</a></form><noscript><style is:global>.composer form,.estimate form{display:none}</style><p>{o.nojs}</p></noscript></section>
<script>
import {selectionURL} from '../lib/pricing';import {readSelection,updateSummary} from '../lib/estimate-ui';
document.querySelectorAll<HTMLElement>('[data-estimate]').forEach(el=>{const form=el.querySelector('form')!;el.querySelector<HTMLFieldSetElement>('[data-enhance]')!.disabled=false;const copy=JSON.parse(el.dataset.copy!);const update=()=>{const s=readSelection(form);if(!Number.isInteger(s.pages)||s.pages<0||s.pages>100)return;updateSummary(el,s,copy,el.dataset.lang!,copy.currency);el.querySelector<HTMLAnchorElement>('[data-estimate-link]')!.href=selectionURL(el.dataset.lang!,s);};form.addEventListener('input',update);form.addEventListener('submit',e=>e.preventDefault());update();});
</script>
