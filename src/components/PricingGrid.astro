---
import {business,type Locale} from '../config';import {offerCopy} from '../offer-copy';import {offerPrice,requestPath,type PriceKey} from '../lib/pricing';import {translations} from '../i18n';
interface Props{lang:Locale}const {lang}=Astro.props;const o=offerCopy[lang];const money=(n:number)=>`${n.toLocaleString(lang)} ${translations[lang].currency}`;
---
<div class="offer-price-grid">{(Object.keys(business.pricing) as PriceKey[]).map(key=><article class="price-card"><h3>{o.labels[key]}</h3><p>{o.from}</p><p class="regular-price">{o.regular}: <s>{money(business.pricing[key])}</s></p><p class="offer-price">{o.offer}: <strong>{key==='languages'?o.free:money(offerPrice(key))}</strong></p><p class="offer-condition">{o.requirement}</p>{key==='languages'&&<p class="offer-condition">{o.terms[0]}</p>}{key==='commerce'&&<p class="offer-condition">{o.terms[1]}</p>}{key==='page'&&<p class="offer-condition">{o.terms[2]}</p>}<a class="price-link" data-offer-cta href={requestPath(lang)}>{o.claim} ↗</a></article>)}</div><div class="maintenance-price"><strong>{o.labels.maintenance}</strong><span>{business.maintenance.toLocaleString(lang)} {o.monthly} — {o.terms[3]}</span></div><aside class="promotion offer-promotion"><h3>{o.title}</h3><p>{o.intro}</p><a class="button primary" data-offer-cta href={requestPath(lang)}>{o.claim} ↗</a><ul>{o.terms.map(term=><li>{term}</li>)}</ul></aside>
