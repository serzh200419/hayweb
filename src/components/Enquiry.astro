---
import {business,languageNames,locales,type Locale} from '../config';import {offerCopy} from '../offer-copy';import {translations} from '../i18n';import ProjectOptions from './ProjectOptions.astro';import EstimateSummary from './EstimateSummary.astro';import {limits} from '../lib/project-request';
interface Props{lang:Locale}const {lang}=Astro.props;const o=offerCopy[lang];
---
<section id="project-request" class="panel composer" data-request-form data-lang={lang} data-copy={JSON.stringify({...o,currency:translations[lang].currency})}><h2>{o.formTitle}</h2><p>{o.formNote}</p><form novalidate><fieldset disabled data-enhance><legend class="sr-only">{o.formTitle}</legend><div class="form-grid">{(['name','business','email','phone','url'] as const).map(key=><div class:list={['field',{'full':key==='url'}]}><label for={key}>{o[key]} {key!=='name'&&<span>({o.optional})</span>}</label><input id={key} name={key} type={key==='email'?'email':key==='phone'?'tel':key==='url'?'url':'text'} autocomplete={{name:'name',business:'organization',email:'email',phone:'tel',url:'url'}[key]} required={key==='name'} maxlength={limits[key]} aria-describedby={key==='email'||key==='phone'?'contact-help':undefined}/></div>)}<p id="contact-help" class="field full">{o.contactHelp}</p><div class="field"><label for="preferred">{o.contact}</label><select id="preferred" name="preferred"><option value="email">{o.email}</option><option value="phone">{translations[lang].contactLabels[1]}</option><option value="whatsapp">WhatsApp</option></select></div><div class="field"><label for="language">{o.language}</label><select id="language" name="language">{locales.map(l=><option value={l} selected={l===lang}>{languageNames[l]}</option>)}</select></div><div class="field full"><label for="description">{o.description}</label><textarea id="description" name="description" rows="6" maxlength={limits.description} required></textarea></div></div><ProjectOptions lang={lang}/><EstimateSummary lang={lang}/><label class="check acknowledgement"><input type="checkbox" name="consent" required/><span>{o.ack}</span></label><div class="honeypot" aria-hidden="true"><label for="website-note">Website</label><input id="website-note" name="website_note" tabindex="-1" autocomplete="off"/></div><div class="error-summary" role="alert" tabindex="-1" hidden><p></p><ul></ul></div><button class="button primary" type="submit">{o.submit} ↗</button><p class="submission-status" role="status"></p></fieldset></form><div class="submission-success" role="status" tabindex="-1" hidden><h3>{o.success}</h3><p>{o.reference}: <strong data-reference></strong></p><a href={business.whatsapp} class="text-link teal">{o.secondary} ↗</a></div><noscript><style is:global>.composer form,.estimate form{display:none}</style><p>{o.nojs}</p></noscript></section>
<script>
import {validateRequest} from '../lib/project-request';import {selectionFromURL} from '../lib/pricing';import {readSelection,setSelection,updateSummary} from '../lib/estimate-ui';
document.querySelectorAll<HTMLElement>('[data-request-form]').forEach(el=>{const form=el.querySelector('form')!;const fieldset=el.querySelector<HTMLFieldSetElement>('[data-enhance]')!;fieldset.disabled=false;const copy=JSON.parse(el.dataset.copy!);const summary=el.querySelector<HTMLElement>('.error-summary')!;const button=el.querySelector<HTMLButtonElement>('button[type=submit]')!;const status=el.querySelector<HTMLElement>('.submission-status')!;let requestId=crypto.randomUUID();let busy=false;setSelection(form,selectionFromURL(location.search));
 const clearErrors=()=>{summary.hidden=true;summary.querySelector('ul')!.replaceChildren();form.querySelectorAll('[aria-invalid]').forEach(input=>input.removeAttribute('aria-invalid'));};
 const showErrors=(fields:Record<string,string>,code='invalid')=>{fieldset.disabled=false;clearErrors();summary.querySelector('p')!.textContent=copy.errors[code]||copy.errors.invalid;for(const [name,error] of Object.entries(fields)){const input=form.querySelector<HTMLElement>(`[name="${name}"]`);const li=document.createElement('li');if(input){input.setAttribute('aria-invalid','true');const link=document.createElement('a');link.href='#'+input.id;link.textContent=copy.errors[error]||copy.errors.invalid;link.addEventListener('click',e=>{e.preventDefault();input.focus();});li.append(link);}else li.textContent=copy.errors[error]||copy.errors.invalid;summary.querySelector('ul')!.append(li);}summary.hidden=false;summary.focus();};
 const update=()=>{const s=readSelection(form);if(Number.isInteger(s.pages)&&s.pages>=0&&s.pages<=100)updateSummary(el,s,copy,el.dataset.lang!,copy.currency);};
 form.addEventListener('input',()=>{if(!busy){requestId=crypto.randomUUID();update();}});update();
 form.addEventListener('submit',async e=>{e.preventDefault();if(busy)return;const data=new FormData(form);const get=(key:string)=>String(data.get(key)||'');const input={requestId,lang:el.dataset.lang,language:get('language'),name:get('name'),business:get('business'),email:get('email'),phone:get('phone'),preferred:get('preferred'),url:get('url'),description:get('description'),consent:data.has('consent'),website_note:get('website_note'),selection:readSelection(form)};const valid=validateRequest(input);if(!valid.value){showErrors(valid.errors);return;}clearErrors();busy=true;button.disabled=true;fieldset.disabled=true;status.textContent=copy.loading;try{const response=await fetch('/api/project-request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(valid.value)});const result=await response.json();if(!response.ok||result.ok!==true||typeof result.reference!=='string'){showErrors(result.fields||{},result.error||'delivery');}else{form.hidden=true;const success=el.querySelector<HTMLElement>('.submission-success')!;success.querySelector('[data-reference]')!.textContent=result.reference;success.hidden=false;success.focus();}}catch{showErrors({},'network');}finally{busy=false;button.disabled=false;fieldset.disabled=false;status.textContent='';}});
});
</script>
