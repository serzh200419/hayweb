---
import {languageNames,locales,type Locale} from '../config';import {translations} from '../i18n';import {pageCopy} from '../page-copy';
interface Props{lang:Locale}const {lang}=Astro.props;const t=translations[lang];const p=pageCopy[lang];
---
<section class="panel composer" data-composer data-lang={lang} data-copy={JSON.stringify({fields:p.fields,invalid:p.invalid,empty:p.empty,message:t.message})}><h2>{p.composer}</h2><p id="draft-note">{p.draftNote}</p><form aria-describedby="draft-note" novalidate><fieldset disabled data-enhance><legend class="sr-only">{p.composer}</legend><div class="form-grid">{['name','business','url'].map((name,i)=><div class:list={['field',{'full':i===2}]}><label for={name}>{p.fields[i]} <span>({p.optional})</span></label><input id={name} name={name} type={i===2?'url':'text'} autocomplete={i===0?'name':i===1?'organization':'url'} maxlength={i===2?1000:160}/></div>)}<div class="field full"><label for="service">{p.fields[3]}</label><select id="service" name="service"><option value="">{p.choose}</option>{t.services.map(([title])=><option>{title}</option>)}</select></div><div class="field full"><label for="description">{p.fields[4]}</label><textarea id="description" name="description" rows="6" maxlength="4000"></textarea></div><div class="field"><label for="preferred">{p.fields[5]}</label><select id="preferred" name="preferred">{locales.map(l=><option value={languageNames[l]} selected={lang===l}>{languageNames[l]}</option>)}</select></div><div class="field"><label for="code">{p.fields[6]} <span>({p.optional})</span></label><input id="code" name="code" maxlength="80"/></div></div><p class="error" id="form-error" role="alert" tabindex="-1"></p><button class="button primary" type="submit">{p.continue} ↗</button></fieldset></form><noscript><p>{p.nojs}</p></noscript></section>
<script>
import {whatsapp} from '../config';
document.querySelectorAll<HTMLElement>('[data-composer]').forEach(el=>{const p=JSON.parse(el.dataset.copy!);const form=el.querySelector('form')!;el.querySelector('fieldset')!.disabled=false;form.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const get=(key:string)=>String(data.get(key)||'').trim();const error=el.querySelector<HTMLElement>('.error')!;const url=el.querySelector<HTMLInputElement>('[name=url]')!;const description=el.querySelector<HTMLTextAreaElement>('[name=description]')!;[url,description].forEach(input=>{input.removeAttribute('aria-invalid');input.removeAttribute('aria-describedby');});error.textContent='';let validURL=true;if(get('url')){try{validURL=['http:','https:'].includes(new URL(get('url')).protocol);}catch{validURL=false;}}const invalid=!validURL?url:!get('description')&&!get('service')?description:null;if(invalid){error.textContent=invalid===url?p.invalid:p.empty;invalid.setAttribute('aria-invalid','true');invalid.setAttribute('aria-describedby','form-error');invalid.focus();return;}const keys=['name','business','url','service','description','preferred','code'];const lines=[p.message,...keys.flatMap((key,i)=>get(key)?[`${p.fields[i]}: ${get(key)}`]:[])];window.location.assign(whatsapp(lines.join('\n')));});});
</script>
