---
import type {Locale} from "../config";
interface Props {lang?:Locale; onDark?:boolean}
const {lang,onDark=false}=Astro.props;
---
<a class:list={['wordmark',{'wordmark--on-dark':onDark}]} href={lang ? `/${lang}/` : "/"} aria-label="HayWeb"><img src="/branding/hayweb-logo.svg" width="1007" height="270" alt="" aria-hidden="true" decoding="async"/></a>
