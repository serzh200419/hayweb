---
import type { Locale } from '../config';
import { translations } from '../i18n';
interface Props {lang: Locale}
const t = translations[Astro.props.lang];
---
<figure class="concept">
 <div class="desktop-frame" aria-hidden="true"><div class="browser-bar"><i></i><i></i><i></i><span>◈</span></div><div class="demo-page"><div class="demo-nav">{t.demo[0]}<span>≡</span></div><div class="demo-content"><div><small>{t.demo[4]}</small><h2>{t.demo[1]}</h2><p>{t.demo[2]}</p><span class="demo-button">{t.demo[3]} ↗</span></div><div class="interior"><div class="arch"></div><div class="sun"></div><div class="plinth"></div><div class="vase"></div><div class="stem"></div></div></div><div class="demo-bottom"><span>01 / 03</span><span>{t.demo[5]}</span><span>↗</span></div></div></div>
 <div class="phone-frame" aria-hidden="true"><div class="phone-notch"></div><div class="demo-nav">{t.demo[0]}</div><div class="interior"><div class="arch"></div><div class="plinth"></div><div class="vase"></div><div class="stem"></div></div><h3>{t.demo[1]}</h3><span class="demo-button">{t.demo[3]} ↗</span></div>
 <figcaption>{t.concept}</figcaption>
</figure>
