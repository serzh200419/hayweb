---
import {offerCopy} from '../offer-copy';import {business,type Locale} from '../config';import {optionKeys,offerPrice} from '../lib/pricing';import {translations} from '../i18n';
interface Props{lang:Locale}const {lang}=Astro.props;const o=offerCopy[lang];
---
<fieldset class="project-options"><legend>{o.options}</legend><p class="option-scope">{o.basePackage}</p>{optionKeys.map(key=><label class="check"><input type="checkbox" name={key} checked={key==='website'}/><span>{o.labels[key]} <small>{key==='languages'?`0 ${translations[lang].currency} - ${o.free}`:`${o.from} ${offerPrice(key).toLocaleString(lang)} ${translations[lang].currency}`}</small></span></label>)}<div class="field"><label for="additional-pages">{o.pages}</label><input type="number" id="additional-pages" name="pages" min="0" max="100" step="1" value="0"/></div><label class="check"><input type="checkbox" name="maintenance"/><span>{o.labels.maintenance}<small>{business.maintenance.toLocaleString(lang)} {o.month}</small></span></label><p class="option-scope">{o.terms[0]}</p><p class="option-scope">{o.terms[1]}</p><p class="option-scope">{o.terms[2]}</p></fieldset>
