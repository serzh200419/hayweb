---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WebsiteConcept from '../../components/WebsiteConcept.astro';
import {locales, business, discounted, total, whatsapp, type Locale} from '../../config';
import {translations} from '../../i18n';
export function getStaticPaths() {return locales.map(lang => ({params:{lang}}));}
const lang = Astro.params.lang as Locale;
const t = translations[lang];
const format = (n: number) => new Intl.NumberFormat({hy:'hy-AM', en:'en-US', ru:'ru-RU'}[lang]).format(n);
const money = (n:number) => `${format(n)} ${t.currency}`;
const prices = Object.values(business.pricing);
const contacts = [whatsapp(t.message), `tel:${business.telephone}`, business.telegram, `mailto:${business.email}`];
---
<Base lang={lang}>
 <SiteHeader lang={lang}/>
 <main id="main">
 <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>{t.hero}</h1><p class="lead">{t.intro}</p><div class="actions"><a class="button primary" href={whatsapp(t.message)}>{t.quote} <span aria-hidden="true">↗</span></a><a class="text-link" href="#services">{t.explore} <span aria-hidden="true">↓</span></a></div><p class="hero-note">{t.note}</p></div><WebsiteConcept lang={lang}/></div><div class="hero-line container"><span>HayWeb</span><span>{t.note}</span></div></section>
 <section class="section container needs"><div class="section-heading"><p class="eyebrow">01 / HayWeb</p><h2>{t.needsTitle}</h2><p>{t.needsIntro}</p></div><div class="three-grid">{t.needs.map(([title,text],i) => <article class="benefit"><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
 <section class="section soft" id="services"><div class="container"><div class="section-heading"><p class="eyebrow">02 / {t.nav[0]}</p><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div><div class="services-grid">{t.services.map(([title,text],i) => <article class="service"><span class="service-icon" aria-hidden="true">{['▧','↗','文','≡','⌕','ϟ','↻','↔','◈','⌖'][i]}</span><div><h3>{title}</h3><p>{text}</p><a href={i===0||i===2||i===3 ? '#pricing':whatsapp(t.message)}>{i===0 ? `${t.from} ${money(prices[0])}` : i===2 ? `${t.extra} ${money(prices[1])}` : i===3 ? `${t.extra} ${money(prices[2])}` : t.quote}<span aria-hidden="true"> ↗</span></a></div></article>)}</div></div></section>
 <section class="features container"><h2>{t.featuresTitle}</h2><ul>{t.features.map(f=><li><span aria-hidden="true">✓</span>{f}</li>)}</ul></section>
 <section class="section container" id="process"><div class="section-heading"><p class="eyebrow">03 / {t.nav[1]}</p><h2>{t.processTitle}</h2><p>{t.processIntro}</p></div><ol class="steps">{t.steps.map(([title,text],i)=><li><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
 <section class="section soft" id="pricing"><div class="container"><div class="section-heading"><p class="eyebrow">04 / {t.nav[2]}</p><h2>{t.pricingTitle}</h2><p>{t.pricingIntro}</p></div><div class="three-grid price-grid">{prices.map((price,i)=><article class:list={['price-card', {featured:i===0}]}><span class="index">0{i+1}</span><h3>{t.priceLabels[i]}</h3><p>{i===0?t.from:t.extra}</p><div class="price">{money(price)}</div><div class="discount-price">{t.offer}: {t.from} <strong>{money(discounted(price))}</strong></div><a href={whatsapp(t.message)} class="price-link">{t.quote} ↗</a></article>)}</div><div class="bundle"><strong>{t.bundle}</strong><span>{t.standard}: {t.from} {money(total)}</span><span>{t.offer}: {t.from} <strong>{money(discounted(total))}</strong></span></div><aside class="promotion"><div><p class="eyebrow">{business.promotion.code} / −{business.promotion.discount * 100}%</p><h3>{t.promoTitle}</h3><p>{t.promoText}</p></div><a class="button primary" href={whatsapp(t.message,true)}>{t.promoCta} ↗</a><ul>{t.terms.map(term=><li>{term}</li>)}</ul></aside></div></section>
 <section class="section container about" id="about"><div class="about-mark" aria-hidden="true"><img src="/branding/hayweb-symbol.svg" width="320" height="320" alt="" class="brand-symbol"/></div><div><p class="eyebrow">05 / {t.nav[3]}</p><h2>{t.aboutTitle}</h2><p>{t.about}</p></div></section>
 <section class="section container faq" id="faq"><div class="section-heading"><p class="eyebrow">06 / {t.nav[4]}</p><h2>{t.faqTitle}</h2></div><div>{t.faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
 <section class="contact section" id="contact"><div class="container contact-grid"><div><p class="eyebrow">07 / {t.nav[5]}</p><h2>{t.contactTitle}</h2><p>{t.contactIntro}</p><a class="button primary" href={whatsapp(t.message)}>{t.quote} ↗</a></div><div class="contact-links">{contacts.map((href,i)=><a href={href}><span>{t.contactLabels[i]}</span><strong>{i===1?business.phone:i===3?business.email:t.contactLabels[i]}</strong><span aria-hidden="true">↗</span></a>)}</div></div></section>
 </main>
 <SiteFooter lang={lang}/>
</Base>
