---
import StudioIcon from '../../components/StudioIcon.astro';
import PricingGrid from '../../components/PricingGrid.astro';
import {requestPath,offerPrice} from '../../lib/pricing';
import {offerCopy} from '../../offer-copy';
import ServiceLinks from '../../components/ServiceLinks.astro';
import {route} from '../../routes';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WebsiteConcept from '../../components/WebsiteConcept.astro';
import {locales, business, whatsapp, type Locale} from '../../config';
import {translations} from '../../i18n';
export function getStaticPaths() {return locales.map(lang => ({params:{lang}}));}
const lang = Astro.params.lang as Locale;
const t = translations[lang];const o=offerCopy[lang];
const format = (n: number) => new Intl.NumberFormat({hy:'hy-AM', en:'en-US', ru:'ru-RU'}[lang]).format(n);
const money = (n:number) => `${format(n)} ${t.currency}`;
const contacts = [whatsapp(t.message), `tel:${business.telephone}`, business.telegram, `mailto:${business.email}`];
---
<Base lang={lang}>
 <SiteHeader lang={lang}/>
 <main id="main">
 <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>{t.hero}</h1><p class="lead">{t.intro}</p><div class="actions"><a class="button primary" href={requestPath(lang)}>{t.quote} <span aria-hidden="true">↗</span></a><a class="text-link" href={route(lang,'services')}>{t.explore} <span aria-hidden="true">↓</span></a></div><p class="hero-offer">{o.intro}</p><p class="hero-note">{t.note}</p></div><WebsiteConcept lang={lang}/></div><div class="hero-line container"><span>HayWeb</span><span>{t.note}</span></div></section>
 <section class="needs-band"><div class="section container needs"><div class="section-heading"><p class="eyebrow">01 / HayWeb</p><h2>{t.needsTitle}</h2><p>{t.needsIntro}</p></div><div class="three-grid">{t.needs.map(([title,text],i) => <article class="benefit"><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
 <section class="section soft" id="services"><div class="container"><div class="section-heading"><p class="eyebrow">02 / {t.nav[0]}</p><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div><div class="services-grid">{t.services.map(([title,text],i) => <article class="service"><span class="service-icon" aria-hidden="true"><StudioIcon index={i}/></span><div><h3>{title}</h3><p>{text}</p><a href={requestPath(lang)}>{i===0 ? `${o.offer}: ${o.from} ${money(offerPrice('website'))}` : i===2 ? o.free : i===3 ? `${o.offer}: ${o.from} ${money(offerPrice('blog'))}` : t.quote}<span aria-hidden="true"> ↗</span></a></div></article>)}</div><ServiceLinks lang={lang}/></div></section>
 <section class="features-band"><div class="features container"><h2>{t.featuresTitle}</h2><ul>{t.features.map(f=><li><span aria-hidden="true">✓</span>{f}</li>)}</ul></div></section>
 <section class="process-section" id="process"><div class="section container"><div class="section-heading"><p class="eyebrow">03 / {t.nav[1]}</p><h2>{t.processTitle}</h2><p>{t.processIntro}</p></div><ol class="steps">{t.steps.map(([title,text],i)=><li><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
 <section class="section soft" id="pricing"><div class="container"><div class="section-heading"><p class="eyebrow">04 / {t.nav[2]}</p><h2>{t.pricingTitle}</h2><p>{t.pricingIntro}</p></div><PricingGrid lang={lang}/></div></section>
 <section class="about-band" id="about"><div class="section container about"><div class="about-mark" aria-hidden="true"><img src="/branding/hayweb-symbol.svg" width="320" height="320" alt="" class="brand-symbol"/></div><div><p class="eyebrow">05 / {t.nav[3]}</p><h2>{t.aboutTitle}</h2><p>{t.about}</p></div></div></section>
 <section class="faq-band" id="faq"><div class="section container faq"><div class="section-heading"><p class="eyebrow">06 / {t.nav[4]}</p><h2>{t.faqTitle}</h2></div><div>{t.faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
 <section class="contact section" id="contact"><div class="container contact-grid"><div><p class="eyebrow">07 / {t.nav[5]}</p><h2>{t.contactTitle}</h2><p>{t.contactIntro}</p><a class="button primary" href={requestPath(lang)}>{t.quote} ↗</a></div><div class="contact-links">{contacts.map((href,i)=><a href={href}><span>{t.contactLabels[i]}</span><strong>{i===1?business.phone:i===3?business.email:t.contactLabels[i]}</strong><span aria-hidden="true">↗</span></a>)}</div></div></section>
 </main>
 <SiteFooter lang={lang}/>
</Base>
