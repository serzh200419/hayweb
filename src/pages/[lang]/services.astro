---
import Page from '../../layouts/Page.astro';import Estimate from '../../components/Estimate.astro';import {locales,business,discounted,whatsapp,type Locale} from '../../config';import {translations} from '../../i18n';import {pageCopy} from '../../page-copy';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Locale;const t=translations[lang];const p=pageCopy[lang];const money=(n:number)=>`${n.toLocaleString(lang)} ${t.currency}`;
---
<Page lang={lang} page="services"><div class="container section service-groups">{p.groups.map(([title,need,deliverables,scope],i)=><section class="service-group"><div><p class="eyebrow">0{i+1}</p><h2>{title}</h2><p class="group-need">{need}</p></div><div><p>{deliverables}</p><p class="scope-note">{scope}</p><a class="text-link teal" href={whatsapp(t.message)}>{t.quote} ↗</a></div></section>)}</div><section class="section soft"><div class="container"><div class="section-heading"><h2>{t.pricingTitle}</h2><p>{t.pricingIntro}</p></div><div class="three-grid">{Object.values(business.pricing).map((price,i)=><article class="price-card"><h3>{t.priceLabels[i]}</h3><p>{i===0?t.from:t.extra}</p><div class="price">{money(price)}</div><p class="discount-price">{t.offer}: {t.from} <strong>{money(discounted(price))}</strong></p></article>)}</div><div class="promotion"><div><h3>{t.promoTitle}</h3><p>{t.promoText}</p></div><a class="button primary" href={whatsapp(t.message,true)}>{t.promoCta} ↗</a><ul>{t.terms.map(term=><li>{term}</li>)}</ul></div><Estimate lang={lang}/></div></section></Page>
