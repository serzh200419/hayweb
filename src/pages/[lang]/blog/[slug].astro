---
import {requestPath} from '../../../lib/pricing';
import {serviceCopy,serviceUi} from '../../../service-copy';
import Base from '../../../layouts/Base.astro';import SiteHeader from '../../../components/SiteHeader.astro';import SiteFooter from '../../../components/SiteFooter.astro';import ArticleCard from '../../../components/ArticleCard.astro';import {publishedArticles,alternativesFor,readingTime,type Article} from '../../../articles';import {route,articleRoute} from '../../../routes';import {pageCopy} from '../../../page-copy';import {translations} from '../../../i18n';import {articleText} from '../../../lib/article-text';
export function getStaticPaths(){return publishedArticles.map(article=>({params:{lang:article.lang,slug:article.slug},props:{article}}));}
interface Props{article:Article}const {article:a}=Astro.props;const lang=a.lang;const description=articleText(a.description,lang);const p=pageCopy[lang];const t=translations[lang];const alternates=alternativesFor(a);const absolute=(path:string)=>new URL(path,Astro.site).href;
const crumbs=[{name:p.home,path:route(lang)},{name:p.blog,path:route(lang,'blog')},{name:a.title,path:articleRoute(lang,a.slug)}];
const schema={'@type':'BlogPosting',headline:a.title,description,datePublished:a.published,...(a.updated?{dateModified:a.updated}:{}),inLanguage:lang,author:{'@type':'Organization',name:'HayWeb'},publisher:{'@id':absolute('/#organization')},mainEntityOfPage:absolute(articleRoute(lang,a.slug)),image:absolute('/social.png')};
---
<Base lang={lang} title={`${a.title} | HayWeb`} description={description} alternates={alternates} article={schema} breadcrumbs={crumbs}><SiteHeader lang={lang} alternates={alternates}/><main id="main"><article><header class="article-header container"><nav class="breadcrumbs" aria-label={p.menu}><a href={route(lang)}>{p.home}</a><span aria-hidden="true">/</span><a href={route(lang,'blog')}>{p.blog}</a></nav><p class="eyebrow">HayWeb · {readingTime(a)} {p.minutes}</p><h1>{a.title}</h1><p class="article-description">{description}</p><p class="article-date">{p.published} <time datetime={a.published}>{new Date(`${a.published}T12:00:00Z`).toLocaleDateString(lang,{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p></header><div class="article-body">{a.sections.map(s=><section><h2>{s.heading}</h2>{s.paragraphs.map(text=><p>{articleText(text,lang)}</p>)}</section>)}<aside class="article-cta"><h2>{t.contactTitle}</h2><p>{t.contactIntro}</p><a class="button primary" href={requestPath(lang)}>{t.quote} ↗</a><a class="text-link teal" href={route(lang,'business-websites')}>{serviceCopy[lang]['business-websites'].h1} ↗</a><p class="article-service-links"><a class="text-link teal" href={route(lang,'multilingual-websites')}>{serviceCopy[lang]['multilingual-websites'].h1}</a></p><a class="text-link teal detail-contact" href={route(lang,'contact')}>{serviceUi[lang].contact}</a></aside><a class="text-link teal" href={route(lang,'blog')}>← {p.back}</a></div></article><section class="container section"><div class="section-heading"><h2>{p.related}</h2></div><div class="article-list">{publishedArticles.filter(b=>b.lang===lang&&a.related.includes(b.id)).map(article=><ArticleCard article={article}/>)}</div></section></main><SiteFooter lang={lang} alternates={alternates}/></Base>
