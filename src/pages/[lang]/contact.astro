---
import FaqList from '../../components/FaqList.astro';
import Page from '../../layouts/Page.astro';import ContactLinks from '../../components/ContactLinks.astro';import Enquiry from '../../components/Enquiry.astro';import {locales,type Locale} from '../../config';import {translations} from '../../i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Locale;const t=translations[lang];
---
<Page lang={lang} page="contact"><div class="container section enquiry-layout"><Enquiry lang={lang}/><aside><h2>{t.contactTitle}</h2><p>{t.contactIntro}</p><ContactLinks lang={lang}/></aside></div><section class="faq-band" id="faq"><div class="section container faq"><div class="section-heading"><h2>{t.faqTitle}</h2></div><FaqList lang={lang} ids={['timeline-materials','after-request']}/></div></section></Page>
