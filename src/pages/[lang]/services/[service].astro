---
import {articleText as resolvePrices} from '../../../lib/article-text';
import Base from '../../../layouts/Base.astro';import SiteHeader from '../../../components/SiteHeader.astro';import SiteFooter from '../../../components/SiteFooter.astro';
import {locales,business,discounted,whatsapp,type Locale} from '../../../config';import {serviceIds,route,pageAlternates,type ServiceId} from '../../../routes';import {serviceCopy,serviceUi} from '../../../service-copy';import {translations} from '../../../i18n';import {pageCopy} from '../../../page-copy';import {publishedArticles} from '../../../articles';import ArticleCard from '../../../components/ArticleCard.astro';
export function getStaticPaths(){return locales.flatMap(lang=>serviceIds.map(service=>({params:{lang,service}})));}
const lang=Astro.params.lang as Locale;const id=Astro.params.service as ServiceId;const s=serviceCopy[lang][id];const ui=serviceUi[lang];const t=translations[lang];const p=pageCopy[lang];const alternatives=pageAlternates(id);const price=business.pricing[id==='business-websites'?'website':'languages'];const money=(n:number)=>`${n.toLocaleString(lang)} ${t.currency}`;
const crumbs=[{name:p.home,path:route(lang)},{name:t.nav[0],path:route(lang,'services')},{name:s.h1,path:route(lang,id)}];
---
<Base lang={lang} title={s.title} description={resolvePrices(s.description,lang)} alternates={alternatives} breadcrumbs={crumbs}><SiteHeader lang={lang} alternates={alternatives}/><main id="main"><section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label={p.menu}><a href={route(lang)}>{p.home}</a><span aria-hidden="true">/</span><a href={route(lang,'services')}>{t.nav[0]}</a></nav><p class="eyebrow">HayWeb / {t.nav[0]}</p><h1>{s.h1}</h1><p class="lead">{s.intro}</p><a class="button primary" href={route(lang,'contact')}>{ui.contact} ↗</a></div></section><div class="section container service-details"><section><h2>{s.audience[0]}</h2><p>{s.audience[1]}</p></section><section><h2>{s.example[0]}</h2><p>{s.example[1]}</p></section>{[s.requirements,s.deliverables].map(([heading,items])=><section><h2>{heading}</h2><ul>{items.map(item=><li>{item}</li>)}</ul></section>)}<section class="detail-scope"><h2>{s.scope[0]}</h2><p>{s.scope[1]}</p><a class="text-link teal" href={route(lang,id==='business-websites'?'multilingual-websites':'business-websites')}>{serviceCopy[lang][id==='business-websites'?'multilingual-websites':'business-websites'].h1} ↗</a></section></div><section class="soft section"><div class="container detail-bottom"><aside class="panel"><h2>{id==='business-websites'?t.priceLabels[0]:t.priceLabels[1]}</h2><p>{id==='business-websites'?t.from:t.extra}</p><p class="price">{money(price)}</p><p class="discount-price">{t.offer}: {t.from} <strong>{money(discounted(price))}</strong></p><p>{t.pricingIntro}</p><p>{t.promoText}</p><ul class="detail-terms">{t.terms.map(term=><li>{term}</li>)}</ul><a class="button primary" href={whatsapp(t.message,true)}>{t.promoCta} ↗</a><a class="text-link teal detail-contact" href={route(lang,'contact')}>{ui.contact} ↗</a></aside><section><h2>{t.nav[4]}</h2>{s.faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</section></div></section><section class="section container"><h2>{ui.guides}</h2><div class="article-list">{publishedArticles.filter(a=>a.lang===lang).map(article=><ArticleCard article={article}/>)}</div></section></main><SiteFooter lang={lang} alternates={alternatives}/></Base>
