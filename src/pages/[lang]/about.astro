---
import Page from '../../layouts/Page.astro';import {locales,whatsapp,type Locale} from '../../config';import {translations} from '../../i18n';import {pageCopy} from '../../page-copy';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Locale;const t=translations[lang];const p=pageCopy[lang];
---
<Page lang={lang} page="about"><section class="section container"><div class="about-intro"><h2>{t.aboutTitle}</h2><p>{t.about}</p></div><div class="principles">{p.principles.map(([title,body],i)=><article><span class="index">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section><section class="section soft"><div class="container"><div class="section-heading"><h2>{t.processTitle}</h2><p>{t.processIntro}</p></div><ol class="steps">{t.steps.map(([title,body],i)=><li><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><a class="button primary" href={whatsapp(t.message)}>{t.quote} ↗</a></div></section></Page>
