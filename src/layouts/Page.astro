---
import {pageMetaTitles} from '../page-meta';
import Base from './Base.astro';import SiteHeader from '../components/SiteHeader.astro';import SiteFooter from '../components/SiteFooter.astro';import {pageAlternates,route} from '../routes';import {pageCopy} from '../page-copy';import {translations} from '../i18n';import type {Locale} from '../config';
interface Props{lang:Locale;page:'services'|'about'|'contact'|'blog'}const {lang,page}=Astro.props;const p=pageCopy[lang];const alternates=pageAlternates(page);const t=translations[lang];const label={services:t.nav[0],about:t.nav[3],contact:t.nav[5],blog:p.blog}[page];
---
<Base lang={lang} title={pageMetaTitles[lang][page]} description={p.descriptions[page]} alternates={alternates} breadcrumbs={[{name:p.home,path:route(lang)},{name:label,path:route(lang,page)}]}><SiteHeader lang={lang} alternates={alternates}/><main id="main"><section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label={p.menu}><a href={route(lang)}>{p.home}</a><span aria-hidden="true">/</span><span>{label}</span></nav><p class="eyebrow">HayWeb / {label}</p><h1>{p.titles[page]}</h1><p class="lead">{p.descriptions[page]}</p></div></section><slot/></main><SiteFooter lang={lang} alternates={alternates}/></Base>
